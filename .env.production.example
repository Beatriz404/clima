# Copiar estas variables en Render → Environment (Web Service clima-glw1)

ENTORNO=produccion
BASE_DATOS_URL=sqlite:////var/data/clima_agricola.db

BATCH_HABILITADO=true
BATCH_AL_INICIAR=true
BATCH_INTERVALO_MINUTOS=30

# Usuarios NO llaman Open-Meteo; solo el batch cada 30 min (datos confiables, sin 429)
PRONOSTICO_SOLO_BATCH=true
PRONOSTICO_MAX_EDAD_MINUTOS=45

CACHE_FORECAST_TTL=1800
CACHE_ARCHIVE_TTL=604800
OPEN_METEO_MAX_CONCURRENT=1
COORDENADAS_REDONDEO_GRADOS=0.02
COORDENADAS_CACHE_DECIMALES=2

CORS_ORIGINS=https://clima-glw1.onrender.com
